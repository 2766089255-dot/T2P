# Required for AI generation and grading
DEEPSEEK_API_KEY=replace_with_your_api_key

# OpenAI-compatible provider settings
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Generation controls
DEFAULT_TEMPERATURE=0.5
DEFAULT_MAX_TOKENS=16384
DEFAULT_TOP_P=0.95
MAX_RETRIES=3

# Feature flags
ENABLE_AI_REVIEW=true
ENABLE_SEMANTIC_DEDUP=true

# OCR.Space free API. "helloworld" is the public demo key; replace it with
# your personal free key from https://ocr.space/ocrapi for normal use.
OCR_SPACE_API_KEY=helloworld
OCR_SPACE_ENGINE=2
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_TIMEOUT=20
# Disable inherited proxy variables on this machine to avoid TLS handshake errors.
OCR_SPACE_TRUST_ENV=false

# Local web origins, comma-separated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional path overrides
# GOLDEN_DATASET_PATH=data/golden_dataset_v3.json
# OUTPUT_DIR=output
# LOG_FILE=logs/t2p_system.log
